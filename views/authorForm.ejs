<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= author ? 'Edit Author' : 'Add Author' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%- include('partials/nav.ejs') %>

  <div class="container mt-4" style="max-width: 600px;">
    <h2><%= author ? 'Edit Author' : 'Add Author' %></h2>
    <form method="POST" action="<%= author ? ('/authors/' + author.authorId + '/edit') : '/authors/new' %>" class="card p-4 shadow-sm">
      <div class="mb-3">
        <label class="form-label">First Name</label>
        <input class="form-control" name="firstName" value="<%= author?.firstName || '' %>" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Last Name</label>
        <input class="form-control" name="lastName" value="<%= author?.lastName || '' %>" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Country</label>
        <input class="form-control" name="country" value="<%= author?.country || '' %>">
      </div>
      <div class="mb-3">
        <label class="form-label">Birth Year</label>
        <input class="form-control" name="birthYear" type="number" value="<%= author?.birthYear || '' %>">
      </div>
      <div class="mb-3">
        <label class="form-label">Death Year</label>
        <input class="form-control" name="deathYear" type="number" value="<%= author?.deathYear || '' %>">
      </div>
      <div class="d-flex gap-2">
        <button class="btn btn-primary">Save</button>
        <a href="/authors" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </div>
</body>
</html>
