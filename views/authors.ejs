<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Authors</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%- include('partials/nav.ejs') %>

  <div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2>Authors</h2>
      <a href="/authors/new" class="btn btn-success">Add Author</a>
    </div>
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Name</th><th>Country</th><th>Birth</th><th>Death</th><th></th>
        </tr>
      </thead>
      <tbody>
        <% authors.forEach(a => { %>
          <tr>
            <td><%= a.firstName %> <%= a.lastName %></td>
            <td><%= a.country || '' %></td>
            <td><%= a.birthYear || '' %></td>
            <td><%= a.deathYear || '' %></td>
            <td class="text-end">
              <a href="/authors/<%= a.authorId %>/edit" class="btn btn-sm btn-primary">Edit</a>
              <form action="/authors/<%= a.authorId %>/delete" method="post" class="d-inline">
                <button class="btn btn-sm btn-danger" onclick="return confirm('Delete this author?')">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</body>
</html>
