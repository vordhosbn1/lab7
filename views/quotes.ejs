<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Quotes</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%- include('partials/nav.ejs') %>

  <div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2>Quotes</h2>
      <a href="/quotes/new" class="btn btn-success">Add Quote</a>
    </div>

    <table class="table table-striped">
      <thead>
        <tr>
          <th>Quote</th>
          <th>Author</th>
          <th>Category</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% quotes.forEach(q => { %>
          <tr>
            <td style="max-width: 400px;"><%= q.quoteText %></td>
            <td><%= q.firstName %> <%= q.lastName %></td>
            <td><%= q.category || '' %></td>
            <td class="text-end">
              <a href="/quotes/<%= q.quoteId %>/edit" class="btn btn-sm btn-primary">Edit</a>
              <form action="/quotes/<%= q.quoteId %>/delete" method="post" class="d-inline">
                <button class="btn btn-sm btn-danger" onclick="return confirm('Delete this quote?')">
                  Delete
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</body>
</html>
