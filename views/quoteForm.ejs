<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= quote ? 'Edit Quote' : 'Add Quote' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%- include('partials/nav.ejs') %>

  <div class="container mt-4" style="max-width: 700px;">
    <h2><%= quote ? 'Edit Quote' : 'Add Quote' %></h2>

    <form method="POST" action="<%= quote ? ('/quotes/' + quote.quoteId + '/edit') : '/quotes/new' %>" class="card p-4 shadow-sm">
      <div class="mb-3">
        <label class="form-label">Quote Text</label>
        <textarea class="form-control" name="quoteText" rows="3" required><%= quote?.quoteText || '' %></textarea>
      </div>

      <div class="mb-3">
        <label class="form-label">Author</label>
        <select class="form-select" name="authorId" required>
          <option value="">Select an author</option>
          <% authors.forEach(a => { %>
            <option value="<%= a.authorId %>"
              <%= quote && quote.authorId === a.authorId ? 'selected' : '' %>>
              <%= a.lastName %>, <%= a.firstName %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="mb-3">
        <label class="form-label">Category</label>
        <select class="form-select" name="category" required>
          <option value="">Select a category</option>
          <% categories.forEach(c => { %>
            <option value="<%= c %>"
              <%= quote && quote.category === c ? 'selected' : '' %>>
              <%= c %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="d-flex gap-2">
        <button class="btn btn-primary">Save</button>
        <a href="/quotes" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </div>
</body>
</html>
