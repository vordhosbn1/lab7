<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Quote Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%- include('partials/nav.ejs') %>

  <div class="container mt-4">
    <h1 class="mb-3">Quote Admin</h1>

    
    <p class="text-muted">Welcome, <%= fullName || 'Admin' %></p>

    <div class="row g-3">
      <div class="col-md-4">
        <a href="/authors" class="card text-decoration-none text-dark shadow-sm">
          <div class="card-body">
            <h5 class="card-title">Authors</h5>
            <p class="card-text">Add, edit, and delete authors.</p>
          </div>
        </a>
      </div>
      <div class="col-md-4">
        <a href="/quotes" class="card text-decoration-none text-dark shadow-sm">
          <div class="card-body">
            <h5 class="card-title">Quotes</h5>
            <p class="card-text">Manage quote text, authors, and categories.</p>
          </div>
        </a>
      </div>
    </div>
  </div>
</body>
</html>
